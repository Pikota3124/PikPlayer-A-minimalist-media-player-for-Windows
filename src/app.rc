#include <winuser.h>
#include "dll.rcinc"   // generado por Compilar.bat: incrusta libmpv dentro del .exe
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "PikPlayer"
      VALUE "ProductName", "PikPlayer"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "OriginalFilename", "PikPlayer.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
